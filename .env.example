# SQLite 数据库文件位置。容器内指向挂载卷；本地开发留空即用 ./data/cinetrace.db
DATABASE_PATH=./data/cinetrace.db

# 原始响应归档目录（gzip 落盘），豆瓣改版后可零请求重解析
ARCHIVE_DIR=./data/archive

# TMDB API Key（v3），在 https://www.themoviedb.org/settings/api 申请。
# 也可以直接在应用「设置」页填写——那里填的优先级更高，改完即时生效无需重启。
TMDB_API_KEY=

# 初始管理员账号。留空即可：首次部署时 seed 会自动生成 admin 与随机密码，
# 并把明文打印到容器日志里（docker compose logs web），登录后请立即改密码。
# 若在这里显式指定，则按此创建，日志同样会打印一次。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 宿主机（NAS）上的访问端口，被 docker-compose.yml 引用；冲突时改这里
# 默认 5533 而非 3000：3000 常被 MoviePilot 等容器占用
WEB_PORT=5533

# 生产环境走 https 时设为 true；NAS 内网 http 访问必须保持 false
COOKIE_SECURE=false

# 时区，影响作息窗口与统计分组
TZ=Asia/Shanghai

# 网络代理。NAS 在国内直连 Debian 源 / npm 常常失败，
# 有代理就填上（Docker 跑在 NAS 上时，localhost 指的是宿主机，填 NAS 的局域网 IP）。
# 构建期与运行期都会使用；不需要就留空。
# 例：HTTP_PROXY=http://192.168.50.110:7890
#
# ⚠️ 本文件必须重命名为 .env（带点）才会被 docker compose 读取；
#    名为 env 或 env.txt 的文件会被直接忽略，且不会报错——这是最常见的踩坑点。
#    改完先验证：docker compose config | grep -i proxy
HTTP_PROXY=
HTTPS_PROXY=
# 局域网与本机地址不走代理
NO_PROXY=localhost,127.0.0.1,::1

# 构建期镜像源加速（建议填）。走国内镜像比绕代理更快更稳：
#   APT_MIRROR 只填主机名，不要带 http:// 或路径
#   NPM_REGISTRY 要填完整地址
# 填了之后这两处会直连镜像站，不再经过上面的代理。
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
NPM_REGISTRY=https://registry.npmmirror.com
