# SQLite 数据库文件位置。容器内指向挂载卷；本地开发留空即用 ./data/cinetrace.db
DATABASE_PATH=./data/cinetrace.db

# 原始响应归档目录（gzip 落盘），豆瓣改版后可零请求重解析
ARCHIVE_DIR=./data/archive

# TMDB API Key（v3），在 https://www.themoviedb.org/settings/api 申请
TMDB_API_KEY=

# 豆瓣用户 ID（movie.douban.com/people/<这里>/collect）
DOUBAN_USER=

# 首次启动引导页之外，也可用 seed 脚本建号；两者都存在时以已有账号为准
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 生产环境走 https 时设为 true；NAS 内网 http 访问必须保持 false
COOKIE_SECURE=false

# 时区，影响作息窗口与统计分组
TZ=Asia/Shanghai
